---
import About from "@/components/site/About.astro";
import Background from "@/components/site/Background.astro";
import Contact from "@/components/site/Contact.astro";
import Experience from "@/components/site/Experience.astro";
import Footer from "@/components/site/Footer.astro";
import Header from "@/components/site/Header.astro";
import Hero from "@/components/site/Hero.astro";
import Projects from "@/components/site/Projects.astro";
import Research from "@/components/site/Research.astro";
import Skills from "@/components/site/Skills.astro";
import { show } from "@/components/site/visibility";
import Base from "@/layouts/Base.astro";
---
<Base>
  <Header />
  <main id="main" tabindex="-1">
    <Hero />
    {show.about && <About />}
    {show.experience && <Experience />}
    {show.projects && <Projects />}
    {show.research && <Research />}
    {show.skills && <Skills />}
    {(show.education || show.achievements) && <Background />}
    {show.contact && <Contact />}
  </main>
  <Footer />
</Base>
